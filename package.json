{
  "name": "lilacanime-desktop",
  "version": "0.4.1",
  "description": "LilacAnime inspired desktop anime library and player",
  "main": "electron/main.cjs",
  "desktopName": "lilacanime-desktop.desktop",
  "author": "LilacAnime Desktop",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/build-jassub.cjs",
    "prestart": "npm run vendor",
    "start": "electron .",
    "predev": "npm run vendor",
    "dev": "electron .",
    "predist": "npm run vendor",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "test": "node --test tests/preload-cache.test.cjs tests/gemini-key-ring.test.cjs tests/legacy-subtitles.test.cjs tests/jimaku-api.test.cjs && node tests/flix-proxy.test.cjs",
    "prepack": "npm run vendor",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jassub": "^2.5.16"
  },
  "build": {
    "appId": "com.lilac.anime.desktop",
    "productName": "LilacAnime",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "LilacAnime",
      "target": "nsis",
      "artifactName": "LilacAnime-Setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Local Linux build <local@localhost>",
      "syncDesktopName": true,
      "target": ["AppImage", "deb"],
      "artifactName": "LilacAnime-${version}-${arch}.${ext}",
      "desktop": { "entry": { "StartupWMClass": "lilacanime-desktop" } }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "cheerio": "^1.1.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3"
  }
}
